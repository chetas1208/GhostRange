# GhostRange — copy to .env.dev (gitignored). No real secrets in git.

# --- Local dev (default: mock provider, no cloud spend) ---
GHOSTRANGE_REPO_ROOT=
GHOSTRANGE_RANGE_DIR=ranges/ghostrange-auth-lab-v1
GHOSTRANGE_GOLDEN_RANGE_DIR=ranges/ghostrange-auth-platform-v2
GHOSTRANGE_LIVE_PROVIDER=mock
GHOSTRANGE_LIVE=
GHOSTRANGE_MAX_WORLDS=1
GHOSTRANGE_API_HOST=127.0.0.1
GHOSTRANGE_API_PORT=8000
GHOSTRANGE_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Vultr (server-side only — copy real values to gitignored .env) ---
# VULTR_API_KEY=              # Compute API token (instances/VPC/workers)
# VULTR_INFERENCE_API_KEY=    # Serverless Inference subscription key
# VULTR_INFERENCE_LABEL=ghostrange-inference
# GHOSTRANGE_CONTROL_HOST=    # ghostrange-control public IPv4
# GHOSTRANGE_CONTROL_SSH_USER=root

# --- Live golden path (explicit; never on by default) ---
# GHOSTRANGE_LIVE=true

# --- Optional infra (docker-compose.dev.yml) ---
POSTGRES_DSN=postgresql://ghostrange:ghostrange@localhost:5432/ghostrange
REDIS_URL=redis://localhost:6379/0

# --- Vultr Managed PostgreSQL (production / optional local against trusted IP) ---
# POSTGRES_DSN=postgresql://USER:PASS@HOST:PORT/defaultdb?sslmode=require

# --- Vultr Object Storage (S3-compatible, server-side only) ---
# OBJECT_STORAGE_PROVIDER=vultr
# S3_ENDPOINT=https://sjc1.vultrobjects.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=ghostrange-artifacts-yourname
# S3_REGION=sjc1
# S3_KEY_PREFIX=artifacts/

# --- NetBird mesh overlay (worker enrollment/connectivity; see .env.production.example
# --- for the full var list and packages/netbird-control for the client). Inert by
# --- default — no behavior change at all unless NETBIRD_ENABLED=true.
# NETBIRD_ENABLED=false
# NETBIRD_API_TOKEN=
# NETBIRD_WORKER_SETUP_KEY=
# NETBIRD_WORKER_GROUP=ghostrange-workers

# --- Frontend ---
# VITE_FIXTURE=m1
# VITE_DATA_SOURCE=FIXTURE
