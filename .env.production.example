# Copy to /opt/ghostrange/.env.production on ghostrange-control (chmod 600).
# Never commit real values. Production stack is **live Vultr only** — no mock provider.

APP_ENV=production
GHOSTRANGE_DEPLOY_SHA=
GHOSTRANGE_REPO_ROOT=/app
GHOSTRANGE_REQUIRE_DURABLE=true
GHOSTRANGE_TRUSTED_PROXY=true
GHOSTRANGE_LIVE_PROVIDER=vultr
GHOSTRANGE_LIVE=true
GHOSTSHIELD_MODE=ENFORCE
GHOSTRANGE_CORS_ORIGINS=

# Vultr Managed PostgreSQL (use Vultr-provided port; append sslmode=require)
POSTGRES_DSN=postgresql://ghostrange_app:CHANGE_ME@vultr-prod-host:16751/defaultdb?sslmode=require

# In compose, REDIS_URL is overridden to valkey service.
REDIS_URL=redis://valkey:6379/0

# Vultr Object Storage (S3-compatible, private bucket)
OBJECT_STORAGE_PROVIDER=vultr
S3_ENDPOINT=https://ewr1.vultrobjects.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=ghostrange-artifacts-CHANGE_ME
S3_REGION=ewr1
S3_KEY_PREFIX=artifacts/

# Vultr Serverless Inference (backend only)
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_MODEL=llama-3.1-8b-instruct

# Vultr Compute (required — no mock workers)
VULTR_API_KEY=
GHOSTSCHEDULER_LIVE=true
GHOSTRANGE_WORKER_VPC_ID=
VULTR_WORKER_REGION=lax
VULTR_WORKER_PLAN=vc2-1c-1gb
VULTR_WORKER_OS_ID=1743
GHOSTRANGE_PUBLIC_URL=https://your-control-host
GHOSTRANGE_LOCAL_CONTROL_URL=http://127.0.0.1:8000

MAX_ACTIVE_WORKERS=10
MAX_ACTIVE_COMPUTE_WORKERS=1
MAX_ACTIVE_INFERENCE_WORKERS=10
MAX_ACTIVE_WORLDS=1
MAX_EXPERIMENT_COST_USD=5
MAX_CAMPAIGN_COST_USD=25
MAX_WORKER_LIFETIME_MINUTES=45
INFERENCE_WORKER_MAX_USD=25

# NetBird (optional; inert unless NETBIRD_ENABLED=true)
NETBIRD_ENABLED=false
