{
  "$defs": {
    "ExposureKind": {
      "enum": [
        "PERCENTAGE",
        "REPLICA_FRACTION",
        "COHORT",
        "REGION",
        "FEATURE_FLAG",
        "CUSTOM"
      ],
      "title": "ExposureKind",
      "type": "string"
    },
    "ExposureV1": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/ExposureKind",
          "default": "PERCENTAGE"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "value": {
          "default": "0",
          "title": "Value",
          "type": "string"
        }
      },
      "title": "ExposureV1",
      "type": "object"
    },
    "ObservedDeploymentStateV1": {
      "additionalProperties": false,
      "properties": {
        "artifact_digest": {
          "default": "",
          "title": "Artifact Digest",
          "type": "string"
        },
        "config_fingerprint": {
          "default": "",
          "title": "Config Fingerprint",
          "type": "string"
        },
        "deployment_revision": {
          "default": "",
          "title": "Deployment Revision",
          "type": "string"
        },
        "infrastructure_fingerprint": {
          "default": "",
          "title": "Infrastructure Fingerprint",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "service_version": {
          "default": "",
          "title": "Service Version",
          "type": "string"
        },
        "source": {
          "default": "adapter",
          "title": "Source",
          "type": "string"
        },
        "traffic_percentage_new": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,
          "title": "Traffic Percentage New",
          "type": "number"
        }
      },
      "title": "ObservedDeploymentStateV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "campaign_id": {
      "format": "uuid",
      "title": "Campaign Id",
      "type": "string"
    },
    "exposure": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExposureV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "observed_state": {
      "$ref": "#/$defs/ObservedDeploymentStateV1"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "campaign_id",
    "observed_state"
  ],
  "title": "ProductionObservationV1",
  "type": "object"
}
