    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "budget": {
      "$ref": "#/$defs/BudgetV1"
    },
    "committed_cost_usd": {
      "default": 0.0,
      "description": "Cost of scheduler decisions already issued this tick/window whose spend has not yet posted to budget.spent_cost_usd.",
      "minimum": 0,
      "title": "Committed Cost Usd",
      "type": "number"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "budget"
  ],
  "title": "BudgetStateV1",
  "type": "object"
}
