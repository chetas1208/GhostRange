    "ArtifactIndexEntryV1": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "description": "sha256:...",
          "title": "Digest",
          "type": "string"
        },
        "logical_name": {
          "title": "Logical Name",
          "type": "string"
        },
        "media_type": {
          "default": "application/octet-stream",
