      "title": "CounterexampleReproducibility",
      "type": "string"
    },
    "MinimalityLevel": {
      "enum": [
        "NOT_MINIMIZED",
        "LOCALLY_MINIMIZED"
      ],
      "title": "MinimalityLevel",
      "type": "string"
