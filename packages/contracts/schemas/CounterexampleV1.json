      },
      "title": "Artifact Ids",
      "type": "array"
    },
    "claim_contradiction": {
      "title": "Claim Contradiction",
      "type": "string"
    },
    "claim_id": {
      "format": "uuid",
      "title": "Claim Id",
      "type": "string"
    },
    "confidence": {
      "default": 0.5,
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "discovered_by": {
      "$ref": "#/$defs/SearchArmKind"
    },
    "evidence_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "minimality": {
      "$ref": "#/$defs/MinimalityLevel",
      "default": "NOT_MINIMIZED"
    },
    "minimized_complexity": {
      "default": 0,
      "title": "Minimized Complexity",
      "type": "integer"
    },
    "observations": {
      "additionalProperties": true,
      "title": "Observations",
      "type": "object"
    },
    "original_complexity": {
      "default": 0,
      "title": "Original Complexity",
      "type": "integer"
    },
    "preconditions": {
      "items": {
        "type": "string"
