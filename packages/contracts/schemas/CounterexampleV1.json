    "reproducibility": {
      "$ref": "#/$defs/CounterexampleReproducibility",
      "default": "UNCONFIRMED"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "search_budget_snapshot": {
      "$ref": "#/$defs/AdversarialBudgetV1"
    },
    "search_run_id": {
      "format": "uuid",
      "title": "Search Run Id",
      "type": "string"
    },
    "search_strategy": {
      "$ref": "#/$defs/SearchPolicyId"
    },
    "violated_invariant": {
      "title": "Violated Invariant",
      "type": "string"
    },
    "world_id": {
      "format": "uuid",
      "title": "World Id",
      "type": "string"
    }
