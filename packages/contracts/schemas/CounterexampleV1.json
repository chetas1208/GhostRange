      "enum": [
        "HEADER_MUTATION",
        "IDENTITY_STATE",
        "SEQUENCE_MUTATION",
        "TIMING",
        "PATH_VARIATION",
        "DEPENDENCY_VARIATION",
        "PARAMETER_MUTATION"
      ],
      "title": "SearchArmKind",
      "type": "string"
    },
    "SearchPolicyId": {
      "enum": [
        "UNIFORM_RANDOM",
        "ROUND_ROBIN",
        "STATIC_PRIORITY",
        "NOVELTY_GREEDY",
        "GHOSTSCHEDULER_SEARCH",
        "UCB"
      ],
      "title": "SearchPolicyId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action_sequence": {
      "items": {
        "additionalProperties": true,
