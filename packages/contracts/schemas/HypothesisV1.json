{
  "$defs": {
    "HypothesisStatus": {
      "enum": [
        "OPEN",
        "SUPPORTED",
        "REFUTED"
      ],
      "title": "HypothesisStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "proposed_by_agent_id": {
      "format": "uuid",
      "title": "Proposed By Agent Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "statement": {
      "title": "Statement",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/HypothesisStatus",
      "default": "OPEN"
    },
    "supporting_evidence_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Supporting Evidence Ids",
      "type": "array"
    },
    "world_id": {
      "format": "uuid",
      "title": "World Id",
      "type": "string"
    }
  },
  "required": [
    "world_id",
    "statement",
    "confidence",
    "proposed_by_agent_id"
  ],
  "title": "HypothesisV1",
  "type": "object"
}
