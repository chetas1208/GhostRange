{
  "$defs": {
    "BeliefLevel": {
      "enum": [
        "UNKNOWN",
        "LOW",
        "MEDIUM",
        "HIGH"
      ],
      "title": "BeliefLevel",
      "type": "string"
    },
    "CandidateOrigin": {
      "enum": [
        "RULE",
        "MODEL",
        "COUNTEREXAMPLE",
        "HUMAN",
        "DRIFT",
        "VERIFICATION_GAP",
        "FIDELITY_GAP"
      ],
      "title": "CandidateOrigin",
      "type": "string"
    },
    "HypothesisEdgeKind": {
      "enum": [
        "SUPPORTS",
        "CONTRADICTS",
        "DEPENDS_ON",
        "REFINES",
        "COMPETES_WITH",
        "EXPLAINS",
        "REQUIRES"
      ],
      "title": "HypothesisEdgeKind",
      "type": "string"
    },
    "HypothesisGraphEdgeV1": {
      "additionalProperties": false,
      "properties": {
        "from_hypothesis_id": {
          "format": "uuid",
          "title": "From Hypothesis Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/HypothesisEdgeKind"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "to_hypothesis_id": {
          "format": "uuid",
          "title": "To Hypothesis Id",
          "type": "string"
        }
      },
      "required": [
        "from_hypothesis_id",
        "to_hypothesis_id",
        "kind"
      ],
      "title": "HypothesisGraphEdgeV1",
      "type": "object"
    },
    "HypothesisGraphV1": {
      "additionalProperties": false,
      "properties": {
        "edges": {
          "items": {
            "$ref": "#/$defs/HypothesisGraphEdgeV1"
          },
          "title": "Edges",
          "type": "array"
        },
        "hypotheses": {
          "items": {
            "$ref": "#/$defs/InvestigationHypothesisV1"
          },
          "title": "Hypotheses",
          "type": "array"
        },
        "investigation_id": {
          "format": "uuid",
          "title": "Investigation Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "investigation_id"
      ],
      "title": "HypothesisGraphV1",
      "type": "object"
    },
    "InvestigationHypothesisStatus": {
      "enum": [
        "PROPOSED",
        "ACTIVE",
        "SUPPORTED",
        "WEAKENED",
        "REFUTED",
        "UNRESOLVED"
      ],
      "title": "InvestigationHypothesisStatus",
      "type": "string"
    },
    "InvestigationHypothesisV1": {
      "additionalProperties": false,
      "description": "M9 investigation hypothesis \u2014 not the incident ``HypothesisV1`` in hypothesis.py.",
      "properties": {
        "contradicting_evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Contradicting Evidence Ids",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "hypothesis_type": {
          "default": "ROOT_CAUSE",
          "title": "Hypothesis Type",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "investigation_id": {
          "format": "uuid",
          "title": "Investigation Id",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/CandidateOrigin",
          "default": "RULE"
        },
        "priority": {
          "$ref": "#/$defs/BeliefLevel",
          "default": "MEDIUM"
        },
        "related_assumption_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Related Assumption Ids",
          "type": "array"
        },
        "related_claim_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Related Claim Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/InvestigationHypothesisStatus",
          "default": "PROPOSED"
        },
        "supporting_evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Supporting Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "investigation_id",
        "statement"
      ],
      "title": "InvestigationHypothesisV1",
      "type": "object"
    },
    "UncertaintyCategory": {
      "enum": [
        "EXPLOITABILITY",
        "REMEDIATION_EFFECTIVENESS",
        "REGRESSION_RISK",
        "ASSUMPTION_VALIDITY",
        "ATTACK_PATH",
        "DEPENDENCY_BEHAVIOR",
        "IDENTITY_BEHAVIOR",
        "CONFIGURATION",
        "FIDELITY",
        "COUNTEREXAMPLE_EXISTENCE",
        "MODEL_DISAGREEMENT",
        "UNKNOWN"
      ],
      "title": "UncertaintyCategory",
      "type": "string"
    },
    "UncertaintyItemV1": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/UncertaintyCategory"
        },
        "confidence_basis": {
          "default": "",
          "title": "Confidence Basis",
          "type": "string"
        },
        "contradicting_evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Contradicting Evidence Ids",
          "type": "array"
        },
        "current_belief": {
          "$ref": "#/$defs/BeliefLevel",
          "default": "UNKNOWN"
        },
        "decision_relevance": {
          "$ref": "#/$defs/BeliefLevel",
          "default": "MEDIUM"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "importance": {
          "$ref": "#/$defs/BeliefLevel",
          "default": "MEDIUM"
        },
        "proposition": {
          "title": "Proposition",
          "type": "string"
        },
        "resolution_conditions": {
          "items": {
            "type": "string"
          },
          "title": "Resolution Conditions",
          "type": "array"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "supporting_evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Supporting Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "subject",
        "proposition",
        "category"
      ],
      "title": "UncertaintyItemV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "claim_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Claim Ids",
      "type": "array"
    },
    "counterexample_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Counterexample Ids",
      "type": "array"
    },
    "experiment_history_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Experiment History Ids",
      "type": "array"
    },
    "hypothesis_graph": {
      "$ref": "#/$defs/HypothesisGraphV1"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "investigation_id": {
      "format": "uuid",
      "title": "Investigation Id",
      "type": "string"
    },
    "knowledge_state_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Knowledge State Hash"
    },
    "known_facts": {
      "items": {
        "type": "string"
      },
      "title": "Known Facts",
      "type": "array"
    },
    "objective": {
      "title": "Objective",
      "type": "string"
    },
    "remaining_questions": {
      "items": {
        "type": "string"
      },
      "title": "Remaining Questions",
      "type": "array"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "uncertain_facts": {
      "items": {
        "type": "string"
      },
      "title": "Uncertain Facts",
      "type": "array"
    },
    "uncertainties": {
      "items": {
        "$ref": "#/$defs/UncertaintyItemV1"
      },
      "title": "Uncertainties",
      "type": "array"
    }
  },
  "required": [
    "investigation_id",
    "objective",
    "hypothesis_graph"
  ],
  "title": "InvestigationKnowledgeStateV1",
  "type": "object"
}
