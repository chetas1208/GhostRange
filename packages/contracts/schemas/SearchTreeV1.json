      "title": "SearchTreeEdgeV1",
      "type": "object"
    },
    "SearchTreeNodeKind": {
      "enum": [
        "HYPOTHESIS",
        "MUTATION",
        "EXECUTION",
        "OBSERVATION",
        "COUNTEREXAMPLE"
