      "title": "SearchTreeNodeKind",
      "type": "string"
    },
    "SearchTreeNodeV1": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
