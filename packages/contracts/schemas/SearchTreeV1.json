        "kind": {
          "$ref": "#/$defs/SearchTreeEdgeKind"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "to_node_id": {
          "format": "uuid",
          "title": "To Node Id",
          "type": "string"
        }
      },
      "required": [
