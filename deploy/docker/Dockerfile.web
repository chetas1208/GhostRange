# syntax=docker/dockerfile:1
FROM node:20-alpine AS build
WORKDIR /repo
COPY package.json package-lock.json* ./
COPY apps/web/package.json apps/web/
COPY packages/ui-3d/package.json packages/ui-3d/
RUN npm ci --ignore-scripts 2>/dev/null || npm install
COPY packages/ui-3d packages/ui-3d
COPY apps/web apps/web
ARG VITE_API_BASE=
ARG VITE_DATA_SOURCE=live
ARG VITE_BOOTSTRAP_M20=true
ARG VITE_ENABLE_TOUR=false
ENV VITE_API_BASE=$VITE_API_BASE
ENV VITE_DATA_SOURCE=$VITE_DATA_SOURCE
ENV VITE_BOOTSTRAP_M20=$VITE_BOOTSTRAP_M20
ENV VITE_ENABLE_TOUR=$VITE_ENABLE_TOUR
RUN npm run build -w apps/web

FROM nginx:1.27-alpine AS runtime
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/web/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --retries=5 \
    CMD wget -qO- http://127.0.0.1:8080/ >/dev/null || exit 1
CMD ["nginx", "-g", "daemon off;"]
